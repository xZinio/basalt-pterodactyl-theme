{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "basalt",
    "type": "theme",
    "name": "Basalt",
    "version": "1.0.0",
    "description": "A graphite-dark panel theme: a glass sidebar, a split sign-in card, a card dashboard with folders and favourites, a server overview, a docked console and a live theme editor.",
    "author": "carlos",
    "icon": "icon.png",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "provider": "Basalt\\BasaltProvider",
    "autoload": {
        "Basalt\\": "app"
    },
    "ui": {
        "entry": "dist/client.js",
        "screens": [
            {
                "id": "console",
                "area": "server",
                "path": "console",
                "nav": { "label": "Console", "icon": "square-terminal", "order": -1000 },
                "when": { "runtime": true }
            },
            {
                "id": "studio",
                "area": "admin",
                "path": "basalt",
                "nav": { "label": "Basalt", "icon": "palette", "order": 1000 }
            }
        ]
    },
    "theme": {
        "extends": "classic",
        "stylesheet": "dist/theme.css",
        "schemes": ["dark", "light"],
        "settings": {
            "background": {
                "type": "color",
                "label": "Page background",
                "tab": "Colors",
                "default": "#1e1e20",
                "token": "--basalt-background"
            },
            "card": {
                "type": "color",
                "label": "Cards",
                "tab": "Colors",
                "default": "#252529",
                "token": "--basalt-card"
            },
            "raised": {
                "type": "color",
                "label": "Menus and raised surfaces",
                "tab": "Colors",
                "default": "#2d2d30",
                "token": "--basalt-raised"
            },
            "border": {
                "type": "color",
                "label": "Borders",
                "tab": "Colors",
                "default": "#3f3f46",
                "token": "--basalt-border"
            },
            "input": {
                "type": "color",
                "label": "Input fields",
                "tab": "Colors",
                "default": "#2d2d30",
                "token": "--basalt-input"
            },
            "sidebar": {
                "type": "color",
                "label": "Sidebar",
                "tab": "Colors",
                "default": "#1a1a1c",
                "token": "--basalt-sidebar"
            },
            "text": {
                "type": "color",
                "label": "Text",
                "tab": "Colors",
                "default": "#fafafa",
                "token": "--basalt-foreground"
            },
            "mutedText": {
                "type": "color",
                "label": "Muted text",
                "tab": "Colors",
                "default": "#a1a1aa",
                "token": "--basalt-muted-foreground"
            },
            "buttonText": {
                "type": "color",
                "label": "Text on buttons",
                "tab": "Colors",
                "default": "#ffffff",
                "token": "--basalt-primary-foreground"
            },
            "accent": {
                "type": "color",
                "label": "Buttons and links",
                "tab": "Colors",
                "default": "#228cf4",
                "token": "--basalt-primary"
            },
            "hover": {
                "type": "color",
                "label": "Hover and focus",
                "tab": "Colors",
                "default": "#4da3f7",
                "token": "--basalt-accent"
            },
            "danger": {
                "type": "color",
                "label": "Danger",
                "tab": "Colors",
                "default": "#e5484d",
                "token": "--basalt-destructive"
            },
            "success": {
                "type": "color",
                "label": "Success",
                "tab": "Colors",
                "default": "#3fb37f",
                "token": "--basalt-success"
            },
            "warning": {
                "type": "color",
                "label": "Warning",
                "tab": "Colors",
                "default": "#f5c451",
                "token": "--basalt-warning"
            },
            "consoleBackground": {
                "type": "color",
                "label": "Console background",
                "tab": "Colors",
                "default": "#161618",
                "token": "--basalt-terminal-background"
            },
            "consoleText": {
                "type": "color",
                "label": "Console text",
                "tab": "Colors",
                "default": "#d4d4d8",
                "token": "--basalt-terminal-foreground"
            },
            "panelName": {
                "type": "text",
                "label": "Panel name",
                "tab": "General",
                "help": "Replaces the panel name in the browser tab, the sidebar and the sign-in page. Leave empty to keep the panel's own name.",
                "default": "",
                "maxLength": 80
            },
            "defaultScheme": {
                "type": "select",
                "label": "Default color mode",
                "tab": "General",
                "help": "Used until a user picks a mode in their account settings.",
                "default": "dark",
                "options": { "system": "Follow the device", "dark": "Dark", "light": "Light" }
            },
            "privacyMode": {
                "type": "toggle",
                "label": "Privacy mode",
                "tab": "General",
                "help": "Lets users blur IP addresses and email addresses, handy when sharing their screen.",
                "default": true
            },
            "keyboardShortcuts": {
                "type": "toggle",
                "label": "Keyboard shortcuts",
                "tab": "General",
                "help": "Lets users move around with shortcuts such as G then D. Press ? to see them all.",
                "default": true
            },
            "userAccent": {
                "type": "toggle",
                "label": "Personal accent color",
                "tab": "General",
                "help": "Lets users pick their own accent color in their account settings.",
                "default": true
            },
            "avatarUploads": {
                "type": "toggle",
                "label": "Avatar uploads",
                "tab": "General",
                "help": "Lets users upload their own avatar instead of Gravatar.",
                "default": true
            },
            "gravatar": {
                "type": "toggle",
                "label": "Gravatar pictures",
                "tab": "General",
                "help": "Show a user's Gravatar until they upload a picture. Loading it sends a hash of their email address to Gravatar.",
                "default": true
            },
            "installableApp": {
                "type": "toggle",
                "label": "Installable app",
                "tab": "General",
                "help": "Lets users install the panel as an app on their phone or computer.",
                "default": true
            },
            "appName": {
                "type": "text",
                "label": "App name",
                "tab": "General",
                "help": "Leave empty to use the panel name.",
                "default": "",
                "maxLength": 40
            },
            "appColor": {
                "type": "color",
                "label": "App color",
                "tab": "General",
                "help": "The color of the app window and splash screen.",
                "default": "#1e1e20"
            },
            "languagePicker": {
                "type": "toggle",
                "label": "Language picker",
                "tab": "General",
                "help": "Lets users pick their language in their account settings.",
                "default": true
            },
            "notifications": {
                "type": "select",
                "label": "Notifications",
                "tab": "General",
                "default": "subtle",
                "attribute": "data-basalt-notifications",
                "options": { "subtle": "Subtle", "solid": "Solid", "minimal": "Minimal" }
            },
            "font": {
                "type": "select",
                "label": "Font",
                "tab": "Text and shape",
                "help": "Fonts other than Poppins, IBM Plex Sans and the system font load from Google Fonts.",
                "default": "poppins",
                "attribute": "data-basalt-font",
                "options": { "poppins": "Poppins", "plex": "IBM Plex Sans (panel default)", "system": "System font", "inter": "Inter", "roboto": "Roboto", "open_sans": "Open Sans", "lato": "Lato", "montserrat": "Montserrat", "nunito_sans": "Nunito Sans", "source_sans_3": "Source Sans 3", "manrope": "Manrope", "dm_sans": "DM Sans", "work_sans": "Work Sans", "outfit": "Outfit", "merriweather": "Merriweather", "playfair_display": "Playfair Display", "roboto_mono": "Roboto Mono", "jetbrains_mono": "JetBrains Mono", "custom": "Custom" }
            },
            "fontCustom": {
                "type": "text",
                "label": "Custom font name",
                "tab": "Text and shape",
                "help": "With the font set to Custom: the font family to use, such as a font installed on visitors' devices or the family of the Google Fonts URL below.",
                "default": "",
                "token": "--basalt-font-custom",
                "maxLength": 100
            },
            "fontUrl": {
                "type": "text",
                "label": "Custom Google Fonts URL",
                "tab": "Text and shape",
                "help": "With the font set to Custom: a https://fonts.googleapis.com/css2?family=… URL to load.",
                "default": "",
                "maxLength": 500
            },
            "radius": {
                "type": "number",
                "label": "Corner radius",
                "tab": "Text and shape",
                "default": 10,
                "min": 0,
                "max": 24,
                "step": 1,
                "unit": "px",
                "token": "--radius"
            },
            "textSize": {
                "type": "number",
                "label": "Text size",
                "tab": "Text and shape",
                "default": 100,
                "min": 90,
                "max": 115,
                "step": 1,
                "unit": "%",
                "token": "--basalt-text-size"
            },
            "borderWidth": {
                "type": "number",
                "label": "Border thickness",
                "tab": "Text and shape",
                "default": 1,
                "min": 0,
                "max": 3,
                "step": 1,
                "unit": "px",
                "token": "--basalt-border-width"
            },
            "shadows": {
                "type": "select",
                "label": "Shadows",
                "tab": "Text and shape",
                "default": "soft",
                "attribute": "data-basalt-shadows",
                "options": { "none": "None", "soft": "Soft", "strong": "Strong" }
            },
            "cardStyle": {
                "type": "select",
                "label": "Card style",
                "tab": "Surfaces",
                "help": "Glass cards are see-through and blur what is behind them, which shows best with a background image.",
                "default": "solid",
                "attribute": "data-basalt-card-style",
                "options": { "solid": "Solid", "glass": "Glass", "outline": "Outlined" }
            },
            "cardOpacity": {
                "type": "number",
                "label": "Card opacity",
                "tab": "Surfaces",
                "help": "How opaque solid cards are. Below 100% the page background shows through.",
                "default": 100,
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "%",
                "token": "--basalt-card-opacity"
            },
            "glass": {
                "type": "toggle",
                "label": "Blur behind menus and the sidebar",
                "tab": "Surfaces",
                "default": true,
                "attribute": "data-basalt-glass"
            },
            "glassBlur": {
                "type": "number",
                "label": "Blur strength",
                "tab": "Surfaces",
                "help": "Used by glass cards and by the blur behind menus and the sidebar.",
                "default": 14,
                "min": 0,
                "max": 32,
                "step": 1,
                "unit": "px",
                "token": "--basalt-glass-blur"
            },
            "boxEdges": {
                "type": "select",
                "label": "Box edges",
                "tab": "Surfaces",
                "default": "soft",
                "attribute": "data-basalt-box-edges",
                "options": { "soft": "Rounded", "flat": "Square", "outline": "Outlined" }
            },
            "inputBorders": {
                "type": "toggle",
                "label": "Input borders",
                "tab": "Controls",
                "help": "Draws a border around text fields and selects.",
                "default": true,
                "attribute": "data-basalt-input-borders"
            },
            "buttonBorders": {
                "type": "toggle",
                "label": "Button borders",
                "tab": "Controls",
                "default": true,
                "attribute": "data-basalt-button-borders"
            },
            "controlRadius": {
                "type": "number",
                "label": "Control corner radius",
                "tab": "Controls",
                "default": 8,
                "min": 0,
                "max": 24,
                "step": 1,
                "unit": "px",
                "token": "--basalt-control-radius"
            },
            "clickFeedback": {
                "type": "toggle",
                "label": "Click feedback",
                "tab": "Controls",
                "help": "Buttons and links shrink slightly while pressed.",
                "default": true,
                "attribute": "data-basalt-click-feedback"
            },
            "contentWidth": {
                "type": "select",
                "label": "Content width",
                "tab": "Layout",
                "help": "Keeps pages from stretching too wide on large screens.",
                "default": "w1600",
                "attribute": "data-basalt-content-width",
                "options": { "full": "Full width", "w1280": "1280 px", "w1440": "1440 px", "w1600": "1600 px", "w1920": "1920 px" }
            },
            "density": {
                "type": "select",
                "label": "Spacing",
                "tab": "Layout",
                "default": "comfortable",
                "attribute": "data-basalt-density",
                "options": { "compact": "Compact", "comfortable": "Comfortable", "spacious": "Spacious" }
            },
            "overviewBackground": {
                "type": "image",
                "label": "Overview background",
                "tab": "Layout",
                "help": "Shown behind the server overview."
            },
            "serverBackground": {
                "type": "image",
                "label": "Server page background",
                "tab": "Layout",
                "help": "Shown behind every server page."
            },
            "backgroundStyle": {
                "type": "select",
                "label": "Background",
                "tab": "Layout",
                "default": "solid",
                "attribute": "data-basalt-background-style",
                "options": { "solid": "Solid", "spotlight": "Spotlight", "gradient": "Gradient" }
            },
            "backgroundImage": {
                "type": "toggle",
                "label": "Background image",
                "tab": "Layout",
                "help": "Shows the uploaded background image, or the image at the URL below when none is uploaded.",
                "default": false
            },
            "backgroundFile": {
                "type": "image",
                "label": "Background image file",
                "tab": "Layout"
            },
            "backgroundUrl": {
                "type": "text",
                "label": "Background image URL",
                "tab": "Layout",
                "help": "An https:// image URL, used when no background image file is uploaded.",
                "default": "",
                "maxLength": 500
            },
            "navigation": {
                "type": "select",
                "label": "Layout style",
                "tab": "Navigation",
                "help": "Controls the panel's main navigation layout.",
                "default": "default",
                "attribute": "data-basalt-navigation",
                "options": { "default": "Default - Standard sidebar on the left", "navbar": "Navbar - Horizontal navigation at the top", "floating": "Floating Sidebar - Floating sidebar with rounded edges", "bottom": "Bottom Bar - Navigation pinned at the bottom" }
            },
            "menuStyle": {
                "type": "select",
                "label": "Menu style",
                "tab": "Navigation",
                "help": "Controls labels and icons in the sidebar, top bar and bottom bar. Collapsible adds a button and remembers each browser's choice.",
                "default": "collapsible",
                "options": { "expanded": "Expanded", "collapsible": "Collapsible", "icon": "Icons only" }
            },
            "sidebarWidth": {
                "type": "number",
                "label": "Sidebar width",
                "tab": "Navigation",
                "default": 16,
                "min": 14,
                "max": 22,
                "step": 0.5,
                "unit": "rem",
                "token": "--layout-sidebar-width"
            },
            "activeItem": {
                "type": "select",
                "label": "Active item",
                "tab": "Navigation",
                "help": "How the page you are on is marked in the menu.",
                "default": "bar",
                "attribute": "data-basalt-active-item",
                "options": { "soft": "Soft tint", "filled": "Filled", "bar": "Side bar", "dot": "Dot", "outline": "Outline", "text": "Colored text" }
            },
            "navHeadings": {
                "type": "toggle",
                "label": "Group headings",
                "tab": "Navigation",
                "help": "Shows the small headings above the groups of menu items.",
                "default": true,
                "attribute": "data-basalt-nav-headings"
            },
            "menuItems": {
                "type": "text",
                "label": "Menu items",
                "tab": "Navigation",
                "help": "Drag items to reorder them or move them to another group. Open an item to rename it or change its icon, and use the eye to hide it.",
                "default": "{}",
                "maxLength": 8000
            },
            "splitView": {
                "type": "toggle",
                "label": "Split view and windows",
                "tab": "Navigation",
                "help": "Lets users right-click a server page link to open it beside the current page or in a floating window.",
                "default": true
            },
            "searchButton": {
                "type": "toggle",
                "label": "Search button",
                "tab": "Navigation",
                "help": "Shows the server search button in the top bar navigation.",
                "default": false
            },
            "searchShortcut": {
                "type": "toggle",
                "label": "Search shortcut",
                "tab": "Navigation",
                "help": "Opens the search with Cmd or Ctrl and the key below, besides the panel's own Cmd or Ctrl + /.",
                "default": true
            },
            "searchKey": {
                "type": "text",
                "label": "Search shortcut key",
                "tab": "Navigation",
                "help": "One letter or digit.",
                "default": "k",
                "maxLength": 1
            },
            "consoleLayout": {
                "type": "select",
                "label": "Layout",
                "tab": "Console",
                "help": "Wide puts the statistics beside the console; Stacked puts them below it.",
                "default": "wide",
                "attribute": "data-basalt-console-layout",
                "options": { "wide": "Wide", "stacked": "Stacked" }
            },
            "consoleDock": {
                "type": "select",
                "label": "Statistics position",
                "tab": "Console",
                "help": "Where the statistics go in the Wide layout.",
                "default": "right",
                "attribute": "data-basalt-console-dock",
                "options": { "right": "Right", "bottom": "Below the console" }
            },
            "consoleStats": {
                "type": "toggle",
                "label": "Show statistics",
                "tab": "Console",
                "default": true
            },
            "consoleGraphs": {
                "type": "toggle",
                "label": "Show graphs",
                "tab": "Console",
                "default": true
            },
            "consoleLogDownload": {
                "type": "toggle",
                "label": "Download log button",
                "tab": "Console",
                "help": "Lets users download the recent console output as a file.",
                "default": true
            },
            "consolePrelude": {
                "type": "text",
                "label": "Command prelude",
                "tab": "Console",
                "help": "The text shown before the panel's own messages in the server console.",
                "default": "container@pterodactyl~",
                "maxLength": 48
            },
            "consolePreludeColor": {
                "type": "color",
                "label": "Prelude color",
                "tab": "Console",
                "help": "The color of the command prelude text.",
                "default": "#4da3f7"
            },
            "editorDirection": {
                "type": "select",
                "label": "File editor direction",
                "tab": "Console",
                "default": "ltr",
                "options": { "ltr": "Left to right", "rtl": "Right to left" }
            },
            "memoryAlert": {
                "type": "number",
                "label": "Memory alert at",
                "tab": "Resource alerts",
                "help": "Shows an upgrade alert on the server dashboard and console when memory use passes this percentage of the limit. 0 turns it off.",
                "default": 90,
                "min": 0,
                "max": 100,
                "step": 5,
                "unit": "%"
            },
            "cpuAlert": {
                "type": "number",
                "label": "CPU alert at",
                "tab": "Resource alerts",
                "help": "Shows the alert when CPU use stays above this percentage of the limit for about ten seconds. 0 turns it off. Servers without a CPU limit never get it.",
                "default": 95,
                "min": 0,
                "max": 100,
                "step": 5,
                "unit": "%"
            },
            "diskAlert": {
                "type": "number",
                "label": "Disk alert at",
                "tab": "Resource alerts",
                "help": "Shows the alert when disk use passes this percentage of the limit. 0 turns it off. Servers without a disk limit never get it.",
                "default": 90,
                "min": 0,
                "max": 100,
                "step": 5,
                "unit": "%"
            },
            "upgradeUrl": {
                "type": "text",
                "label": "Upgrade link",
                "tab": "Resource alerts",
                "help": "Where the Upgrade button in the alert sends users, such as your store. Leave empty to show no button.",
                "default": "",
                "maxLength": 500
            },
            "alertMessage": {
                "type": "text",
                "label": "Alert message",
                "tab": "Resource alerts",
                "help": "Replaces the default message of every alert. Leave empty for the default messages.",
                "default": "",
                "maxLength": 160
            },
            "motion": {
                "type": "select",
                "label": "Animation",
                "tab": "Motion",
                "default": "full",
                "attribute": "data-basalt-motion",
                "options": { "full": "Full", "reduced": "Reduced", "none": "None" }
            },
            "pageTransition": {
                "type": "select",
                "label": "Page transition",
                "tab": "Motion",
                "default": "fade",
                "attribute": "data-basalt-page-transition",
                "options": { "none": "Off", "fade": "Fade", "lift": "Fade and lift" }
            },
            "overviewReveal": {
                "type": "select",
                "label": "Overview servers",
                "tab": "Motion",
                "default": "lift",
                "attribute": "data-basalt-overview-reveal",
                "options": { "none": "Off", "fade": "Fade in", "lift": "Fade and lift" }
            },
            "motionSpeed": {
                "type": "select",
                "label": "Speed",
                "tab": "Motion",
                "default": "standard",
                "attribute": "data-basalt-motion-speed",
                "options": { "quick": "Quick (120 ms)", "standard": "Standard (180 ms)", "relaxed": "Relaxed (240 ms)" }
            },
            "hoverEffect": {
                "type": "select",
                "label": "Hover effect",
                "tab": "Motion",
                "default": "default",
                "attribute": "data-basalt-hover-effect",
                "options": { "default": "Default", "filled": "Filled", "filled_secondary": "Filled secondary", "icon_pill": "Icon pill", "pill": "Pill", "pill_secondary": "Pill secondary" }
            },
            "logo": {
                "type": "image",
                "label": "Logo",
                "tab": "Branding",
                "help": "Shown in the sidebar and, without a sign-in logo, on the sign-in page.",
                "token": "--brand-logo"
            },
            "logoHeight": {
                "type": "number",
                "label": "Logo height",
                "tab": "Branding",
                "default": 28,
                "min": 16,
                "max": 64,
                "step": 1,
                "unit": "px",
                "token": "--basalt-logo-height"
            },
            "hideName": {
                "type": "toggle",
                "label": "Hide the panel name next to the logo",
                "tab": "Branding",
                "default": false,
                "attribute": "data-basalt-hide-name"
            },
            "favicon": {
                "type": "image",
                "label": "Favicon",
                "tab": "Branding",
                "help": "The browser tab icon."
            },
            "supportUrl": {
                "type": "text",
                "label": "Support link",
                "tab": "Branding",
                "help": "An https:// URL or a path beginning with /. Shown in the account menu and on the sign-in page.",
                "default": "",
                "maxLength": 500
            },
            "loginLogo": {
                "type": "image",
                "label": "Logo",
                "tab": "Sign-in",
                "help": "Replaces the logo on the sign-in page."
            },
            "loginImage": {
                "type": "image",
                "label": "Background",
                "tab": "Sign-in",
                "help": "Behind the card, or in the banner of the banner layouts, which show built-in artwork without one.",
                "token": "--basalt-login-image"
            },
            "loginLayout": {
                "type": "select",
                "label": "Layout",
                "tab": "Sign-in",
                "options": { "centered": "Centered", "flat": "Flat", "banner": "Side banner", "floating": "Floating banner", "panels": "Panels" },
                "default": "banner",
                "attribute": "data-basalt-login-layout"
            },
            "loginCardStyle": {
                "type": "select",
                "label": "Card style",
                "tab": "Sign-in",
                "options": { "solid": "Solid", "glass": "Glass", "outline": "Outlined" },
                "default": "solid",
                "attribute": "data-basalt-login-card-style"
            },
            "loginCardOpacity": {
                "type": "number",
