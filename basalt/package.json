{
    "name": "basalt",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "typecheck": "tsc",
        "test": "vitest run",
        "test:watch": "vitest",
        "panel": "docker compose -f ../dev/docker-compose.yml exec -T panel php artisan",
        "install-dev": "npm run build && npm run panel -- p:extension:install /src/basalt --enable --replace",
        "doctor": "npm run panel -- p:extension:doctor /src/basalt",
        "types": "npm run panel -- p:extension:types /src/basalt",
        "pack": "npm run panel -- p:extension:pack /src/basalt --force"
    },
    "devDependencies": {
        "@fontsource/poppins": "^5.2.6",
        "@pterodactyl/sdk": "file:../.panel/packages/sdk",
        "@tanstack/react-query": "^5",
        "@base-ui/react": "^1.6.0",
        "@tanstack/form-core": "^1.33.0",
        "@tanstack/react-form": "^1.33.0",
        "@tanstack/react-router": "^1.170.17",
        "axios": "^1.20.0",
        "lucide-react": "^1.17.0",
        "sonner": "^2.0.7",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^6",
        "vite": "^8",
        "vitest": "^4.1.9",
        "jsdom": "^26.1.0",
        "@testing-library/react": "^16",
        "@testing-library/dom": "^10",
        "@types/node": "^22",
        "tailwindcss": "^4.3.0",
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/postcss": "^4",
        "postcss": "^8.5.6"
    }
}
